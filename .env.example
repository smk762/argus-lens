# ── Backend selection ────────────────────────────────────────────────
# Default backend for `argus-lens serve` (hybrid, wd14, florence2, openai,
# openai-compat, replay, ...). Equivalent to `serve --backend`.
ARGUS_BACKEND=hybrid

# ── Replay backend (--backend replay) ────────────────────────────────
# Serves recorded captions from the cortex Postgres lineage store instead of
# running a model — no GPU, no external API. Keyed by the source image's
# sha256 (the id cortex records on source_asset). Needs the [replay] extra
# (psycopg). Set CORTEX_PG_URL to the lineage database:
CORTEX_PG_URL=

# ── Cloud backend credentials ────────────────────────────────────────
# Each cloud backend reads its own key; set the one(s) you use.
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
HF_TOKEN=
NVIDIA_API_KEY=

# ── Generic OpenAI-compatible backend (--backend openai-compat) ──────
# Point at any server speaking the OpenAI /chat/completions format:
# Ollama, vLLM, LM Studio, LocalAI, llama.cpp, or a hosted proxy.
# Defaults to Ollama on localhost; pick any vision-capable model.
# For a hybrid with WD14 tags + VLM prose: ARGUS_BACKEND=hybrid:wd14+openai-compat
ARGUS_OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
ARGUS_OPENAI_COMPAT_MODEL=llava
# API key is optional — most local servers don't need one.
ARGUS_OPENAI_COMPAT_API_KEY=
# User prompt: preset (detailed, straightforward, descriptive, booru, count)
# or literal text. "straightforward" suits JoyCaption and Qwen3-VL for training.
ARGUS_OPENAI_COMPAT_PROMPT=detailed

# ── LLM refinement (optional) ────────────────────────────────────────
# Rewrites assembled captions with a chat model; every rewrite is validated
# (identity, token budget, grounding) and falls back to the deterministic
# caption. Unset ARGUS_REFINE_MODEL = off. A text-only instruct model is enough.
ARGUS_REFINE_MODEL=
ARGUS_REFINE_BASE_URL=http://localhost:11434/v1
ARGUS_REFINE_API_KEY=
ARGUS_REFINE_VARIANTS=training,training_prose

# ── Local model paths ────────────────────────────────────────────────
# WD14 ONNX model directory. If unset, defaults to ~/.cache/wd14_tagger/
# and auto-downloads from HuggingFace on first use.
WD14_MODEL_DIR=/home/smk/.cache/wd14_tagger
# WD14 v3 tagger to use (default SmilingWolf/wd-vit-tagger-v3). The most
# accurate is SmilingWolf/wd-eva02-large-tagger-v3; non-default repos download
# into a per-repo subdirectory of the cache.
WD14_MODEL_REPO=

# HuggingFace cache directory for transformer models (Florence-2, BLIP-2).
# Defaults to ~/.cache/huggingface if unset. These auto-download on first use.
HF_HOME=/home/smk/.cache/huggingface

# ── GPU sharing ──────────────────────────────────────────────────────
# Unload models after N idle seconds so another GPU tenant (ComfyUI) gets the
# VRAM back; they reload lazily on the next request. Unset = keep loaded.
# Leave it unset with ARGUS_GPU_COORDINATOR=broker: iris owns idle eviction.
ARGUS_IDLE_UNLOAD_S=
# none | lease (one argus GPU job at a time across the suite, via a host-wide
# lock file, started once the card has room) | broker (argus-iris, the suite's
# GPU broker, grants the lease and evicts idle models to make room).
ARGUS_GPU_COORDINATOR=none
# Docker: host directory holding the shared lease lock, mounted by every argus
# GPU service (argus-curator's compose uses the same default).
ARGUS_GPU_LOCK_DIR=/tmp/argus-gpu

# ── argus-iris GPU broker (ARGUS_GPU_COORDINATOR=broker) ─────────────
# Where iris listens, by IP (e.g. http://<GPU_BROKER_HOST>:8120): the container does not
# resolve LAN host names, which is why argus-iris's own config uses IPs.
ARGUS_GPU_BROKER_URL=
# Shared caller token (Authorization: Bearer). Secret: host .env only.
ARGUS_GPU_BROKER_TOKEN=
# The committed tenant manifest (the Docker image ships it at
# /app/gpu-tenant.yaml, compose's default). Or name the tenant alone with
# ARGUS_GPU_TENANT=argus-lens.
ARGUS_GPU_TENANT_MANIFEST=
ARGUS_GPU_TENANT=
# Coordinator to use when iris is unreachable or answers 5xx: lease | none.
ARGUS_GPU_BROKER_FALLBACK=lease
# Bearer token guarding POST /admin/unload; iris calls it to evict lens's model.
# Use the suite's shared value. Secret: host .env only. Unset = route is open.
ARGUS_ADMIN_TOKEN=

# ── Lineage recording (the replay tape) ─────────────────────────────
# 1 = record every live caption into the cortex lineage store (needs
# CORTEX_PG_URL); CORTEX_S3_* also stores the original bytes. Never set on a
# replay host: it reads the same CORTEX_PG_URL.
LENS_RECORD_LINEAGE=
CORTEX_PG_URL=
CORTEX_S3_ENDPOINT=
CORTEX_S3_BUCKET=
CORTEX_S3_ACCESS_KEY=
CORTEX_S3_SECRET_KEY=

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated origins allowed CORS *and* cross-site writes. The Docker
# image runs `serve --cors`, which trusts only http://localhost:3000; set this
# when the studio is served from another host/port (e.g. a LAN IP).
LENS_CORS_ORIGINS=
# Host names (no port) this server is reached by, e.g. morpheus. A browser page
# served from this server's own host:port may write only when that host is an
# IP, localhost, or listed here (DNS rebinding guard).
LENS_TRUSTED_HOSTS=

# ── Folder browsing (caption page folder picker) ─────────────────────
# Root folder exposed by GET /folders and POST /caption/folder; both are
# confined to this root. Equivalent to `serve --source-root`.
# Native `serve`: unset = folder browsing and folder captioning disabled.
# Docker (docker-compose.yaml): the HOST folder bind-mounted read-write at
# /data/images in the container (default /data/images); sidecars are
# written next to the images.
LENS_SOURCE_PATH=/data/images

# ── Agent tooling (not read by this service) ──
# ai-code-auditor audit API base that AGENTS.md tells coding agents to use.
# Put the real host/IP in your local .env, never here.
# AI_AUDIT_PUBLIC_BASE_URL=http://<AUDIT_HOST>:8765
