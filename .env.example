# ── Backend selection ────────────────────────────────────────────────
# Default backend for `argus-lens serve` (hybrid, wd14, florence2, openai,
# openai-compat, replay, ...). Equivalent to `serve --backend`.
ARGUS_BACKEND=hybrid

# ── Replay backend (--backend replay) ────────────────────────────────
# Serves recorded captions from the cortex Postgres lineage store instead of
# running a model — no GPU, no external API. Keyed by the source image's
# sha256 (the id cortex records on source_asset). Needs the [replay] extra
# (psycopg). Set CORTEX_PG_URL to the lineage database:
CORTEX_PG_URL=

# ── Cloud backend credentials ────────────────────────────────────────
# Each cloud backend reads its own key; set the one(s) you use.
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
HF_TOKEN=
NVIDIA_API_KEY=

# ── Generic OpenAI-compatible backend (--backend openai-compat) ──────
# Point at any server speaking the OpenAI /chat/completions format:
# Ollama, vLLM, LM Studio, LocalAI, llama.cpp, or a hosted proxy.
# Defaults to Ollama on localhost; pick any vision-capable model.
# For a hybrid with WD14 tags + VLM prose: ARGUS_BACKEND=hybrid:wd14+openai-compat
ARGUS_OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
ARGUS_OPENAI_COMPAT_MODEL=llava
# API key is optional — most local servers don't need one.
ARGUS_OPENAI_COMPAT_API_KEY=
# User prompt: preset (detailed, straightforward, descriptive, booru, count)
# or literal text. "straightforward" suits JoyCaption and Qwen3-VL for training.
ARGUS_OPENAI_COMPAT_PROMPT=detailed

# ── LLM refinement (optional) ────────────────────────────────────────
# Rewrites assembled captions with a chat model; every rewrite is validated
# (identity, token budget, grounding) and falls back to the deterministic
# caption. Unset ARGUS_REFINE_MODEL = off. A text-only instruct model is enough.
ARGUS_REFINE_MODEL=
ARGUS_REFINE_BASE_URL=http://localhost:11434/v1
ARGUS_REFINE_API_KEY=
ARGUS_REFINE_VARIANTS=training,training_prose

# ── Local model paths ────────────────────────────────────────────────
# WD14 ONNX model directory. If unset, defaults to ~/.cache/wd14_tagger/
# and auto-downloads from HuggingFace on first use.
WD14_MODEL_DIR=/home/smk/.cache/wd14_tagger
# WD14 v3 tagger to use (default SmilingWolf/wd-vit-tagger-v3). The most
# accurate is SmilingWolf/wd-eva02-large-tagger-v3; non-default repos download
# into a per-repo subdirectory of the cache.
WD14_MODEL_REPO=

# HuggingFace cache directory for transformer models (Florence-2, BLIP-2).
# Defaults to ~/.cache/huggingface if unset. These auto-download on first use.
HF_HOME=/home/smk/.cache/huggingface

# ── GPU sharing ──────────────────────────────────────────────────────
# Unload models after N idle seconds so another GPU tenant (ComfyUI) gets the
# VRAM back; they reload lazily on the next request. Unset = keep loaded.
ARGUS_IDLE_UNLOAD_S=
# none | lease (one argus job at a time, host file lock) | gothmog
ARGUS_GPU_COORDINATOR=none

# ── Folder browsing (caption page folder picker) ─────────────────────
# Root folder exposed by GET /folders and POST /caption/folder; both are
# confined to this root. Equivalent to `serve --source-root`.
# Unset = folder browsing and folder captioning disabled.
LENS_SOURCE_PATH=/data/images
