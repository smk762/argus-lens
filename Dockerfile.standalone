# Self-contained image built straight from source — no gpu_base / prebuilt wheel needed.
# Used by the argus-vision-demo suite compose so `docker compose up` works in one step.
# The GPU-native path (Dockerfile + Dockerfile.gpu-base + build-docker.sh) is unchanged.
#
#   EXTRAS   pip extras to install (default self-contained local backend).
#            Use "server,openai,replicate" for a light cloud-only image.
#   VERSION  build version (.git is excluded from the context, so hatch-vcs
#            cannot infer it — we pretend via setuptools-scm).
FROM python:3.11-slim

# eMudhra/emSign (discuss.python.org/t/109576): refresh Debian's trust store and
# distrust emSign ECC Root CA - G3 plus the Comodo AAA cross-sign root. Unaffected
# emSign roots stay enabled, matching certifi 2026.10.19. pip below 26.2.2 trusts
# its vendored bundle in addition to this store, so the OS update is not enough.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libgl1 libglib2.0-0 libgomp1 \
    && sed -i \
        -e 's|^mozilla/emSign_ECC_Root_CA_-_G3|!mozilla/emSign_ECC_Root_CA_-_G3|' \
        -e 's|^mozilla/Comodo_AAA|!mozilla/Comodo_AAA|' \
        /etc/ca-certificates.conf \
    && update-ca-certificates --fresh >/dev/null \
    && python - <<'PY' && rm -rf /var/lib/apt/lists/*
import base64, pathlib, re, sys
conf = pathlib.Path("/etc/ca-certificates.conf").read_text().splitlines()
root = pathlib.Path("/usr/share/ca-certificates")
for name in (
    "mozilla/emSign_ECC_Root_CA_-_G3.crt",
    "mozilla/Comodo_AAA_Services_root.crt",
):
    if (root / name).is_file() and f"!{name}" not in conf:
        sys.exit(f"failed to distrust {name}")
bundle = pathlib.Path("/etc/ssl/certs/ca-certificates.crt").read_bytes()
bad = (b"emSign ECC Root CA - G3", b"AAA Certificate Services")
for pem in re.findall(b"-----BEGIN CERTIFICATE-----(.+?)-----END CERTIFICATE-----", bundle, re.S):
    der = base64.b64decode(pem)
    for name in bad:
        if name in der:
            sys.exit(f"compromised root still trusted: {name.decode()}")
PY

WORKDIR /app

ARG EXTRAS=server,local
ARG VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${VERSION}

COPY . /app
# Hash-pinned wheel: the pip that ships in the base image would otherwise
# download its own upgrade with the compromised bundle.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
        "pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70" \
    && python -m pip install "certifi>=2026.10.19" ".[${EXTRAS}]"

EXPOSE 8100
# Folder browsing/captioning is confined to this root — mount your images here.
ENV LENS_SOURCE_PATH=/data
CMD ["argus-lens", "serve", "--port", "8100", "--cors"]
